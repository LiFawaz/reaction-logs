{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@valenced/types"]
  },
  "include": ["${configDir}/**/*", "types"],
  "exclude": ["${configDir}/build", "${configDir}/node_modules"]
}